<?xml version="1.0" encoding="utf-8"?>
<!-- Xiaomi 4x1 Widget: Kanal Adı, BÜYÜK VE ARASI AÇIK Play/Pause ve Next Düğmeleri -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Sol Taraf: Radyo İkonu ve Kanal Bilgisi -->
    <ImageView
        android:id="@+id/widget_radio_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_stat_radio"
        android:contentDescription="Radyo İkonu" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kral FM"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="92.0 MHz • Canlı"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- SAĞ TARAF: BÜYÜK VE ARASI AÇIK TUŞLAR (KULLANICI TALEBİ: DOKUNMASI KOLAY) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- BÜYÜK PLAY / PAUSE DÜĞMESİ (52dp x 52dp) -->
        <ImageButton
            android:id="@+id/widget_button_play_pause"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/button_round_orange"
            android:src="@drawable/ic_play"
            android:contentDescription="Play veya Pause"
            android:scaleType="centerInside"
            android:padding="10dp" />

        <!-- DÜĞMELER ARASI AÇIK BOŞLUK (18dp) -->
        <View
            android:layout_width="18dp"
            android:layout_height="1dp" />

        <!-- BÜYÜK NEXT (SONRAKİ KANAL) DÜĞMESİ (54dp x 54dp) -->
        <ImageButton
            android:id="@+id/widget_button_next"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/button_round_gray"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="Sonraki Kanal"
            android:scaleType="centerInside"
            android:padding="10dp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Kanal Bilgisi (Sol Taraf - Daha sola çekildi) -->
    <LinearLayout
        android:id="@+id/channel_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@id/controls_layout"
        android:orientation="vertical"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="6dp">

        <TextView
            android:id="@+id/widget_station"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kral FM"
            android:textColor="#F26D21"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Canlı Yayın"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Sağ Taraftaki Büyük ve Aralıklı Kontrol Butonları -->
    <LinearLayout
        android:id="@+id/controls_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="4dp"
            android:src="@drawable/ic_custom_prev" />

        <ImageView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:padding="4dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/ic_custom_play" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="4dp"
            android:src="@drawable/ic_custom_next" />
    </LinearLayout>
</RelativeLayout>
